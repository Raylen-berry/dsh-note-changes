{
  "name": "dsh-note-changes",
  "version": "1.10.0",
  "description": "DSH 会话中的 Obsidian 风格笔记插页：目录、搜索、双链、Markdown 编辑与 GitHub 双电脑同步。",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "obsidian",
    "vault",
    "git",
    "notes"
  ],
  "type": "module",
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./package.json": "./package.json"
  },
  "scripts": {
    "test": "node tools/run-all.mjs",
    "build": "node tools/build-client.mjs",
    "check": "node --check index.js && node --check client.js && node tools/build-client.mjs --check",
    "test:browser": "node tools/browser-check.mjs && node tools/browser-plus-check.mjs && node tools/browser-settings-check.mjs"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "README.md",
    "lib",
    "vendor"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-client-ui-slots"
      ],
      "platform": "web"
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-host-webserver": "^0.1.2-alpha.1",
    "react": "^18.2.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/Raylen-berry/dsh-note-changes"
  },
  "license": "MIT"
}
